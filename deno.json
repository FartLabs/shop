{
  "lock": false,
  "tasks": {
    "start": "deno serve --parallel --env --allow-read --allow-net --allow-env main.tsx",
    "check": "deno fmt --check && deno lint && deno check **/*.ts && deno check **/*.tsx",
    "outdated": "deno outdated --update --latest"
  },
  "compilerOptions": { "jsx": "react-jsx", "jsxImportSource": "preact" },
  "imports": {
    "@/": "./",
    "@std/http": "jsr:@std/http@^1.0.20",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "preact": "npm:preact@10.27.2",
    "@preact/signals": "npm:@preact/signals@2.3.1",
    "@preact/signals-core": "npm:@preact/signals-core@1.12.1",
    "preact-helmet": "npm:preact-helmet@^4.0.0-alpha-3",
    "preact-render-to-string": "npm:preact-render-to-string@^6.6.1"
  }
}
